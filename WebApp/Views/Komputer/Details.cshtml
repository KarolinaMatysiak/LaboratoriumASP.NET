@model Komputer

@{
    ViewBag.Title = "Szczegóły";
    Layout = "_Layout";
}

<style>
    table {
        font-family: arial, sans-serif;
        border-collapse: collapse;
        width: 100%;

    }

    td, th {
        border: 1px solid #dddddd;
        text-align: left;
        padding: 8px;
    }

    tr:nth-child(even) {
        background-color: white;
    }
</style>

<table>
    <thead>
    <tr>
        <th style="padding: 10px; background-color: pink;"> @Html.DisplayNameFor(model => model.Nazwa) </th>
       

        <th style="padding: 10px; background-color: pink;"> @Html.DisplayNameFor(model => model.Procesor)</th>
       

        <th style="padding: 10px; background-color: pink;"> @Html.DisplayNameFor(model => model.Pamiec)</th>
      

        <th style="padding: 10px; background-color: pink;"> @Html.DisplayNameFor(model => model.DataProdukcji)</th>
       

        <th style="padding: 10px; background-color: pink;"> @Html.DisplayNameFor(model => model.Producent) </th>
        

        <th style="padding: 10px; background-color: pink;"> @Html.DisplayNameFor(model => model.Id)</th>
     

        <th style="padding: 10px; background-color: pink;"> @Html.DisplayNameFor(model => model.Created) </th>
       
    </tr>
    </thead>
    <tbody>
    <tr>
    <td style="padding: 10px;">@Model.Nazwa</td>
    <td style="padding: 10px;"> @Model.Procesor</td>
    <td style="padding: 10px;"> @Model.Pamiec</td>
    <td style="padding: 10px;"> @Model.DataProdukcji</td>
    <td style="padding: 10px;">@Model.Producent</td>
    <td style="padding: 10px;"> @Model.Id</td>
    <td style="padding: 10px;"> @Model.Created</td>
    <tr>
        <tbody>
</table>

<div class="mt-3">
    <a class="btn btn-primary" asp-action="Index">Powrót do listy</a>
</div>
