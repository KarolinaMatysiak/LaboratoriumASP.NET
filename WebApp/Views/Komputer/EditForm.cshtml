@model Komputer
@{
    ViewData["Title"] = "Komputer";
}

<!DOCTYPE html>

<html>
<head>
    <title>Komputer</title>
</head>
<body>
<div class="container">
    <div class="row justify-content-md-center">
        <div class="col-6">
            <h2>Edytuj komputer</h2>
            <form action="Komputer/Save" method="POST">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="Created" value="@Model.Created" />
                <div>
                    <label asp-for="Category"></label>
                    <div>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>
                    <select class="form-control" asp-for="Category" asp-items="@Html.GetEnumSelectList<Category>()"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="nazwa">Nazwa komputera</label>
                    <span asp-validation-for="Nazwa" class="text-danger"></span>
                    <input class="form-control" type="text" name="nazwa" step="0.00001" id="1" value="@Model.Nazwa" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="procesor">Procesor</label>
                    <span asp-validation-for="Procesor" class="text-danger"></span>
                    <input class="form-control" type="text" name="procesor" step="0.00001" id="2" value="@Model.Procesor" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="pamiec">Pamięć</label>
                    <span asp-validation-for="Pamiec" class="text-danger"></span>
                    <input class="form-control" type="number" name="pamiec" step="0.00001" id="3" value="@Model.Pamiec" />
                </div>
                <div class="mb-3">
                    <div class="mb-3">
                        <label class="form-label" for="kartaGraficzna">Karta Graficzna</label>
                        <span asp-validation-for="KartaGraficzna" class="text-danger"></span>
                        <input class="form-control" type="text" name="kartaGraficzna" step="0.00001" id="4" value="@Model.KartaGraficzna" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="producent">Producent</label>
                        <span asp-validation-for="Producent" class="text-danger"></span>
                        <input class="form-control" type="text" name="producent" step="0.00001" id="5"  value="@Model.Producent" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="DataProdukcji">Data Produkcji</label>
                        <span asp-validation-for="DataProdukcji" class="text-danger"></span>
                        <input class="form-control" type="date" name="DataProdukcji" step="0.00001" id="6" value="@Model.DataProdukcji.Value.ToString("yyyy-MM-dd")" />
                    </div>
                    <button class="btn btn-primary" type="submit">Zapisz</button>
                </div>
            </form>
        </div>
    </div>
</div>
</body>
</html>