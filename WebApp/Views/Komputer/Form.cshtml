@model Komputer
@{
    ViewData["Title"] = "Komputer";
}

<!DOCTYPE html>

<html>
<head>
    <title>Komputer</title>
</head>
<body>
<div class="container">
    <div class="row justify-content-md-center">
        <div class="col-6">
            <h2>Stwórz komputer</h2>
            <form action="Create" method="POST">
                <div>
                    <label asp-for="Category"></label>
                    <div>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>
                    <select class="form-control" asp-for="Category" asp-items="@Html.GetEnumSelectList<Category>()"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="Nazwa"></label>
                    <span asp-validation-for="Nazwa" class="text-danger"></span>
                    <input class="form-control" type="text" name="nazwa" step="0.00001" id="1"/>
                </div>
                <div class="mb-3">
                    <label  asp-for="Procesor"></label>
                    <span asp-validation-for="Procesor" class="text-danger"></span>
                    <input class="form-control" type="text" name="procesor" step="0.00001" id="2"/>
                </div>
                <div class="mb-3">
                    <label asp-for="Pamiec"></label>
                    <span asp-validation-for="Pamiec" class="text-danger"></span>
                    <input class="form-control" type="number" name="pamiec" step="0.00001" id="3"/>
                </div>
                <div class="mb-3">
                    <div class="mb-3">
                        <label asp-for="KartaGraficzna"></label>
                        <span asp-validation-for="KartaGraficzna" class="text-danger"></span>
                        <input class="form-control" type="text" name="kartaGraficzna" step="0.00001" id="4"/>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Producent"></label>
                        <span asp-validation-for="Producent" class="text-danger"></span>
                        <input class="form-control" type="text" name="producent" step="0.00001" id="5"/>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DataProdukcji"></label>
                        <span asp-validation-for="DataProdukcji" class="text-danger"></span>
                        <input class="form-control" type="date" name="dataProdukcji" step="0.00001" id="6"/>
                    </div>
                    <div class="mb-3">
                        <label asp-for="OrganizationId"></label>
                        <select class= "form-select" asp-for="OrganizationId" asp-items = "@Model.Organizations"></select>
                        <span asp-validation-for="OrganizationId" class="text-danger"></span>
                    </div>
                    <button class="btn btn-primary" type="submit">Stwórz</button>
                </div>
            </form>
        </div>
    </div>
</div>
</body>
</html>