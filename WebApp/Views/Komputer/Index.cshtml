@model  List<Komputer>

<style>
    table {
        font-family: arial, sans-serif;
        border-collapse: collapse;
        width: 100%;
   
    }

    td, th {
        border: 1px solid #dddddd;
        text-align: left;
        padding: 8px;
    }

    tr:nth-child(even) {
        background-color: white;
    }
</style>

<h2>Lista komputerów</h2>


@if (Model.Count > 0){

<table style="width: 100%; border-collapse: collapse;">
    <thead>
    
    <tr>
        <th style="padding: 10px; background-color: pink;"> @Html.DisplayNameFor(model => model[0].Id)</th>
        <th style="padding: 10px; background-color: pink;"> @Html.DisplayNameFor(model => model[0].Created)</th>
        <th style="padding: 10px; background-color: pink;"> @Html.DisplayNameFor(model => model[0].Nazwa)</th>
        <th style="padding: 10px; background-color: pink;"> @Html.DisplayNameFor(model => model[0].Procesor)</th>
        <th style="padding: 10px; background-color: pink;"> @Html.DisplayNameFor(model => model[0].Pamiec)</th>
        <th style="padding: 10px; background-color: pink;"> @Html.DisplayNameFor(model => model[0].DataProdukcji)</th>
        <th style="padding: 10px; background-color: pink;"> @Html.DisplayNameFor(model => model[0].Category)</th>
        <th style="padding: 10px; background-color: pink;"></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var komputer in @Model)
    {
        <tr>
            <td style="padding: 10px;">@komputer.Id</td>
            <td style="padding: 10px;">@komputer.Created</td>
        
            <td style="padding: 10px;">@komputer.Nazwa</td>
            <td style="padding: 10px;">@komputer.Procesor</td>
            <td style="padding: 10px;">@komputer.Pamiec</td>
            <td style="padding: 10px;">@komputer.DataProdukcji?.ToShortDateString()</td>
            <td style="padding: 10px;">@komputer.Category.GetDisplayName()</td>
            <td>
                <a class="btn btn-primary"
                   asp-action="Edit"
                   asp-controller="Komputer"
                   asp-route-id=@komputer.Id>Edytuj</a>
                <a class="btn btn-primary"
                   asp-action="Details"
                   asp-controller="Komputer"
                   asp-route-id=@komputer.Id>Szczegóły</a>
                <a class="btn btn-primary"
                   asp-action="Delete"
                   asp-controller="Komputer"
                   asp-route-id=@komputer.Id>Usuń</a>
            </td>
        </tr>
    }
    </tbody>
</table>
}