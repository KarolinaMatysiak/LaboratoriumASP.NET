@using Microsoft.AspNetCore.Mvc.TagHelpers
@model WebApp.Models.University.CriteriaModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Details</h1>

<div>
    <hr/>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CriteriaUniversity.UniversityName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CriteriaUniversity.UniversityName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CriteriaUniversity.Country)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CriteriaUniversity.Country)
        </dd>
    </dl>
    <hr/>
</div>

<form method="GET" asp-action="Details">
    <input type="hidden" name="universityId" value="@Model.CriteriaUniversity.UniversityId" />

    <div>
        @Html.DisplayNameFor(model => model.RankingSystems)
        @Html.DropDownList(
            "systemId",
            new SelectList(Model.RankingSystems.Select(x => new SelectListItem
            {
                Text = x.Name,
                Value = x.Id.ToString()
            }), "Value", "Text"),
            "-",
            new { onchange = "this.form.submit();" }
        )
        <hr/>
    </div>


    <table class="table">
        <thead>
        <tr>
            <th>
                Criterion
            </th>
            @for (var i = 0; i < DateTime.Now.Year - Model.StartYear + 1; i++)
            {
                <th>
                    @(Model.StartYear + i)
                </th>
            }
        </tr>
        </thead>

        <tbody>
        @foreach (var item in Model.CriteriaRecords)
        {
            <tr>
                <td>
                    @item.Name
                </td>
                @for (int i = 0; i < DateTime.Now.Year - Model.StartYear + 1; i++)
                {
                    <td>
                        @{
                            var score = item.Data.GetValueOrDefault((int)Model.StartYear + i, null);
                            var scoreString = (score != null ? score.ToString() : "-")!;
                        }
                        @scoreString
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
</form>

<div>
    @* <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> | *@
    <a asp-action="Index" class="btn btn-primary" >Back to List</a>
</div>
<br/>

<a asp-action="AddRanking" asp-route-universityId="@Model.CriteriaUniversity.UniversityId" class="btn btn-primary">
    Add Ranking
</a>