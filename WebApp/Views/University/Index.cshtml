@model IEnumerable<WebApp.Models.University.UniversityIndex>


@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.UniversityName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CountryName)
        </th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.UniversityName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CountryName)
            </td>
            <td>
                @foreach (var rankingSystem in item.RankingSystems)
                {
                    <a asp-action="Details" asp-route-systemId="@rankingSystem.RankingSystemId" asp-route-universityId="@item.UniversityId">@rankingSystem.RankingSystemName</a>
                    <br/>
                }
            </td>
        </tr>
    }
    </tbody>
</table>